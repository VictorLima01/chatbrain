# Segredos - NUNCA versionar
.env
.env.*
!.env.example
*.pem
*.key

# Build
ibm/target/
web/dist/
web/node_modules/
web/*.tsbuildinfo

# Material de estudo pesado — os videos nao sao usados pela ingestao
*.mp4
*.MP4

# Copia local do material quando MATERIAL_PROVIDER=filesystem (sem Docker).
# E um espelho do bucket, nao a fonte: nao versionar.
material/

# Material de estudo - a fonte de verdade e o bucket S3 (passo 3).
# 133 PDFs, ~100 MB: nao inchar o repositorio com o que ja esta no S3.
ingestao/

# Mesma regra para o material do modulo apptio-costing (65 arquivos, 21 MB):
# copia local do que esta em modules/apptio-costing/ no bucket.
ingestao-apptio-costing/

# IDE / SO
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Terraform
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
# State solto na raiz, de um terraform rodado fora de infra/. Nao e so sujeira:
# state versionado vaza o que estiver marcado como sensitive.
/terraform.tfstate
/terraform.tfstate.*
infra/terraform.tfvars
infra/tfplan

# O .terraform.lock.hcl NAO entra aqui de proposito: versiona-lo e o que
# garante a mesma versao do provider em qualquer maquina. Nao tem segredo.

# Tarball do front gerado no 9.3 -- artefato de build, vive no S3
web-*.tar.gz
