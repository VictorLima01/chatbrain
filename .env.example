# Copie para .env e preencha. O .env NAO deve ir para o Git.

# Obrigatoria — chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Opcionais
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
DB_PASSWORD=cloudability

# ------------------------------------------------------------------- banco
# Em branco, a API usa o Postgres do compose (servico `db`). Preencha os tres
# para apontar para um banco externo — e o que a fase 2 faz para validar o Neon
# antes de subir qualquer coisa na AWS. NAO basta trocar DB_PASSWORD: sem
# DB_URL e DB_USER a API continua falando com o `db` local, agora com a senha
# errada, e o Flyway falha com "password authentication failed".
# DB_URL=jdbc:postgresql://ep-xxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_USER=neondb_owner
# DB_PASSWORD=<sua-senha-do-neon>

# ---------------------------------------------------------------- material
# Bucket onde o material vive, com uma pasta por modulo: modules/<slug>/...
# Local, quem serve esse bucket e o LocalStack (ver docker-compose.yml) e as
# credenciais abaixo sao de brinquedo. Na AWS elas nao existem: o EC2 acessa o
# bucket pela IAM Role da instancia.
MATERIAL_BUCKET=cloudability-material
MATERIAL_ACCESS_KEY=test
MATERIAL_SECRET_KEY=test
AWS_REGION=us-east-1

# ----------------------------------------------------------------- alcadas
# admin = cria modulos e envia material. student = so consulta.
# AINDA NAO HA AUTENTICACAO: este e o nivel de qualquer um que abrir a aplicacao.
# Nao publique na internet com admin aqui.
ACCESS_DEFAULT_LEVEL=admin

# true = indexa o material de todos os modulos automaticamente no primeiro boot.
# Deixe false e use o botao "Sincronizar" na area de administracao para
# acompanhar o progresso.
KB_AUTO_INGEST=false
